# 이 파일을 .env 로 복사해서 값을 채우세요 (.env 는 git에 올라가지 않습니다).
# Claude Code 클라우드 세션이라면 환경 설정(세션 제목 표시줄 → 환경 메뉴 → Edit)의 환경변수에 같은 이름으로 넣으세요.

# 네이버 검색 API
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# hub = 네이버 클라우드 'NAVER API HUB' 키(기본) / openapi = 옛 developers.naver.com 키
NAVER_API_BACKEND=hub
# 하루 호출 상한 (검색 API 상한은 일 25,000건). 도달하면 요청 전에 멈춤
NAVER_DAILY_CALL_BUDGET=1000

# Crossref 'polite pool' 용 연락처 이메일 (선택이지만 권장)
CROSSREF_MAILTO=
